<Window x:Class="PartMap.Dialogs.SelectModelFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要重命名的文件" Width="520" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="这个文件组里有多个文件，请选择要重命名的那个："
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <ListBox x:Name="FilesList" Grid.Row="1" DisplayMemberPath="DisplayName" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="88" Margin="0,0,8,0" Content="取消" IsCancel="True" />
            <Button Width="88" Content="确定" IsDefault="True" Click="Confirm_OnClick" />
        </StackPanel>
    </Grid>
</Window>