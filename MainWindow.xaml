<Window x:Class="PartMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PartMap · 图像文件管理器" Width="1440" Height="900"
        MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen"
        Icon="PartMap-icon.ico"
        AllowDrop="True" PreviewDragOver="Window_OnPreviewDragOver" PreviewDragLeave="Window_OnPreviewDragLeave"
        PreviewDrop="Window_OnPreviewDrop"
        Background="{StaticResource PageBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PartMap" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="图像文件管理器" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProductPicker" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center" SelectionChanged="ProductPicker_OnSelectionChanged" />
                    <Button x:Name="RenameProductButton" Grid.Column="1" Content="改名" Margin="5,0,0,0" IsEnabled="False"
                            Padding="9,6" ToolTip="修改当前产品名称，不移动模型文件"
                            Click="RenameProduct_OnClick" />
                    <Button x:Name="DeleteProductButton" Grid.Column="2" Content="删除" Margin="5,0,0,0" IsEnabled="False"
                            Padding="9,6" ToolTip="只删除 PartMap 本机产品记录，不删除模型文件或共享配置"
                            Click="DeleteProduct_OnClick" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="7,0,0,0">
                    <Button Content="＋ 新建产品" Style="{StaticResource PrimaryButtonStyle}" Click="NewProduct_OnClick" />
                    <Button Content="导入文件夹" ToolTip="读取模型目录中的 PartMap.product.json" Click="ImportProductFolder_OnClick" />
                    <Button Content="刷新" Click="Refresh_OnClick" />
                    <Button x:Name="OpenModelsButton" Content="模型目录" Click="OpenModels_OnClick" />
                    <Button x:Name="ChangeModelsButton" Content="重选目录" Click="ChangeModels_OnClick" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="EditModeToggle" Content="布局编辑" Padding="15,8" Margin="3"
                                  Checked="EditMode_OnChanged" Unchecked="EditMode_OnChanged" />
                    <Button x:Name="DrawHotspotButton" Content="框选部件" IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" Click="DrawHotspot_OnClick" />
                    <TextBlock VerticalAlignment="Center" Margin="13,0,6,0" Foreground="{StaticResource MutedTextBrush}" Text="缩放" />
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="0.2" Maximum="2.5" Value="1"
                            TickFrequency="0.1" ValueChanged="ZoomSlider_OnValueChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           Text="请选择或新建产品。" TextTrimming="CharacterEllipsis" />
                <CheckBox x:Name="IncludeSubdirectoriesToggle" Grid.Column="1" Margin="14,0,0,0"
                          VerticalAlignment="Center" Content="读取子目录" IsEnabled="False"
                          ToolTip="默认关闭；开启后读取并监控模型根目录下的所有子目录"
                          Checked="IncludeSubdirectories_OnChanged" Unchecked="IncludeSubdirectories_OnChanged" />
                <Button x:Name="ExcludedDirectoriesButton" Grid.Column="2" Margin="12,0,0,0" Padding="10,5"
                        Content="排除文件夹…" IsEnabled="False" Click="ExcludedDirectories_OnClick" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="显示" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="FileTypeFilter" Width="150" SelectedIndex="0"
                              SelectionChanged="FileTypeFilter_OnSelectionChanged">
                        <ComboBoxItem Content="全部 3MF" />
                        <ComboBoxItem Content="仅 .gcode.3mf" />
                        <ComboBoxItem Content="仅普通 .3mf" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="0" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border x:Name="GroupsPanel" Grid.Column="0" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Visibility="Collapsed"
                    AllowDrop="True" DragOver="GroupsPanel_OnDragOver" Drop="GroupsPanel_OnDrop">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="Bold" Text="待归类文件" />
                                <TextBlock x:Name="UnmappedGroupCountText" Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" Text="0 个文件组" />
                            </StackPanel>
                            <ToggleButton x:Name="ShowAllGroupsToggle" Grid.Column="1" Content="显示全部"
                                          Padding="11,6" MinHeight="32"
                                          Checked="ShowAllGroupsToggle_OnChanged"
                                          Unchecked="ShowAllGroupsToggle_OnChanged" />
                        </Grid>
                        <TextBlock x:Name="GroupHintText" Margin="0,12,0,8" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Text="把待归类文件组拖到图片中的热点；已分类内容默认隐藏。" />
                        <Button Content="重命名选中文件" HorizontalAlignment="Stretch" Click="RenameGroup_OnClick" />
                        <Separator Margin="0,10,0,4" Background="{StaticResource LineBrush}" />
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="GroupsList" BorderThickness="0" Background="Transparent"
                                 PreviewMouseLeftButtonDown="GroupsList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="GroupsList_OnPreviewMouseMove"
                                 MouseDoubleClick="GroupsList_OnMouseDoubleClick" KeyDown="GroupsList_OnKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Files.Count, StringFormat={}{0} 个 3MF}" Margin="0,3,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="7,3" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding MappingStatus}" Foreground="#0F887B" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyGroupsText" Text="所有文件都已归类" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftPanelSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed" />

            <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" CornerRadius="12"
                    BorderBrush="#18202C" BorderThickness="1">
                <Grid Margin="8">
                    <ScrollViewer x:Name="DiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False" PanningMode="Both">
                        <Grid x:Name="DiagramSurface" HorizontalAlignment="Center" VerticalAlignment="Center"
                              MouseLeftButtonDown="DiagramSurface_OnMouseLeftButtonDown"
                              MouseMove="DiagramSurface_OnMouseMove"
                              MouseLeftButtonUp="DiagramSurface_OnMouseLeftButtonUp">
                            <Image x:Name="DiagramImage" Stretch="Fill" />
                            <Canvas x:Name="HotspotCanvas" Background="Transparent" />
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="WelcomePanel" Background="#F0232C3A" Padding="34" CornerRadius="14"
                            BorderBrush="#394557" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Border Width="54" Height="54" CornerRadius="16" Background="#2514B8A6" HorizontalAlignment="Center">
                                <TextBlock Text="＋" Foreground="#58D6C9" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,14,0,0"
                                       HorizontalAlignment="Center" Text="从产品包装图开始" />
                            <TextBlock Foreground="#AEBAC9" FontSize="13" Margin="0,8,0,16"
                                       Text="创建产品后，在图片部件位置绘制透明点击区域。" />
                            <Button Content="新建第一个产品" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center" Click="NewProduct_OnClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="FilesPanelDropTarget" Grid.Column="4" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" Height="20" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                            <TextBlock FontSize="17" FontWeight="Bold" Text="部件文件" />
                        </StackPanel>
                        <TextBlock x:Name="SelectedHotspotText" Margin="0,8,0,10"
                                   Foreground="{StaticResource MutedTextBrush}" Text="点击产品图中的部件查看文件。" TextWrapping="Wrap" />
                        <WrapPanel x:Name="HotspotActions" IsEnabled="False" Visibility="Collapsed">
                            <Button Content="修改名称" Click="RenameHotspot_OnClick" />
                            <Button Content="复制热点" Click="DuplicateHotspot_OnClick" />
                            <Button Content="移除选中组" Click="RemoveGroupFromHotspot_OnClick" />
                            <Button Content="删除热点" Style="{StaticResource DangerButtonStyle}" Click="DeleteHotspot_OnClick" />
                        </WrapPanel>
                        <Separator Margin="0,10" Background="{StaticResource LineBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Separator Margin="0,0,0,8" Background="{StaticResource LineBrush}" />
                        <WrapPanel>
                            <Button Content="打开" Style="{StaticResource PrimaryButtonStyle}" Click="OpenFile_OnClick" />
                            <Button x:Name="OneClickSliceButton" Content="一键切片" ToolTip="用 Bambu Studio 切片；自动生成 vN_时间_克重 文件名并归档旧版本"
                                    Click="OneClickSlice_OnClick" />
                            <Button x:Name="BatchSliceButton" Content="批量切片" ToolTip="把选中的普通 3MF 加入串行切片队列"
                                    Click="BatchSlice_OnClick" />
                            <Button Content="F2 重命名" Click="RenameFile_OnClick" />
                            <Button Content="所在文件夹" Click="RevealFile_OnClick" />
                            <Button Content="复制路径" Click="CopyPath_OnClick" />
                            <Button Content="归到历史" ToolTip="移动到模型根目录的历史文件夹，并在文件名后加入日期"
                                    Click="ArchiveFile_OnClick" />
                            <Button Content="删除文件" Style="{StaticResource DangerButtonStyle}" Click="DeleteFile_OnClick" />
                        </WrapPanel>
                        <TextBlock Margin="4,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                                    Text="双击打开；Delete 删除到回收站；拖入右栏可加入当前部件，也可把文件卡片拖出去。" />
                    </StackPanel>

                    <Grid>
                        <Grid.Resources>
                            <DataTemplate x:Key="FileCardTemplate">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" Background="White" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="3MF" Foreground="#9AA7B8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Margin="3" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastModifiedText}" Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                        <Border Margin="0,5,0,0" Padding="7,2" HorizontalAlignment="Left"
                                                Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                                            <TextBlock Text="{Binding GroupKey}" Foreground="#0F887B" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="StandardFilesSectionRow" Height="*" />
                            <RowDefinition x:Name="FileSectionsSeparatorRow" Height="8" />
                            <RowDefinition x:Name="GcodeFilesSectionRow" Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" MinHeight="100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="普通 3MF" Margin="4,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Grid Grid.Row="1">
                                <ListBox x:Name="FilesList" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                                         ItemTemplate="{StaticResource FileCardTemplate}"
                                         SelectionChanged="FilesList_OnSelectionChanged"
                                         MouseDoubleClick="FilesList_OnMouseDoubleClick"
                                         PreviewMouseLeftButtonDown="FilesList_OnPreviewMouseLeftButtonDown"
                                         PreviewMouseMove="FilesList_OnPreviewMouseMove"
                                         KeyDown="FilesList_OnKeyDown" />
                                <TextBlock x:Name="EmptyFilesText" Text="没有普通 .3mf 文件"
                                           IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="4" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Focusable="False"
                                      Background="{StaticResource LineBrush}" />
                        <Grid Grid.Row="2" MinHeight="100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="G-code 3MF" Margin="4,4,0,6" FontWeight="SemiBold"
                                       Foreground="#0F887B" />
                            <Grid Grid.Row="1">
                                <ListBox x:Name="GcodeFilesList" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                                         ItemTemplate="{StaticResource FileCardTemplate}"
                                         SelectionChanged="FilesList_OnSelectionChanged"
                                         MouseDoubleClick="FilesList_OnMouseDoubleClick"
                                         PreviewMouseLeftButtonDown="FilesList_OnPreviewMouseLeftButtonDown"
                                         PreviewMouseMove="FilesList_OnPreviewMouseMove"
                                         KeyDown="FilesList_OnKeyDown" />
                                <TextBlock x:Name="EmptyGcodeFilesText" Text="没有 .gcode.3mf 文件"
                                           IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
